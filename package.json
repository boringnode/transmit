{
  "name": "@boringnode/transmit",
  "description": "A framework agnostic Server-Sent-Event library",
  "version": "0.4.2",
  "engines": {
    "node": ">=20.6"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./transports": "./build/transports.js",
    "./types": "./build/src/types/main.js"
  },
  "scripts": {
    "build": "yarn compile",
    "clean": "del-cli build",
    "compile": "yarn clean && tsc",
    "format": "prettier --write .",
    "lint": "eslint .",
    "precompile": "yarn lint",
    "prepublishOnly": "yarn build",
    "pretest": "yarn lint",
    "quick:test": "yarn node --enable-source-maps --import=ts-node-maintained/register/esm bin/test.ts",
    "release": "release-it",
    "test": "c8 yarn quick:test",
    "typecheck": "tsc --noEmit",
    "version": "yarn build"
  },
  "dependencies": {
    "@boringnode/bus": "^0.10.0",
    "@poppinss/utils": "^7.1.2",
    "emittery": "^1.2.1",
    "matchit": "^1.1.0"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^20.19.43",
    "c8": "^12.0.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "ts-node-maintained": "^10.9.6",
    "typescript": "^7.0.2"
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boringnode/transmit"
  },
  "keywords": [
    "sse",
    "server-sent-event",
    "realtime",
    "real-time"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "release-it": {
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "preMajor": true
        }
      }
    },
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "volta": {
    "node": "24.22.0"
  },
  "packageManager": "yarn@4.18.1"
}
